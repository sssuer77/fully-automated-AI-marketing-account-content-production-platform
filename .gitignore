# ── 前端 ────────────────────────────────────────────────
web/node_modules/
web/dist/
web/.vite/
web/coverage/
web/*.tsbuildinfo
# 生成物**故意入库**（T4.1）：OpenAPI / WS 契约的漂移只有在 diff 里才看得见，
# 也因此 `npm run build` 能从干净克隆直接跑。禁止手改；后端改完跑 `tasks.ps1 web:gen`。
!web/openapi.json
!web/src/api/types.gen.ts
!web/src/ws/events.ts

# ── TTS 运行时项目 ──────────────────────────────────────
tts/.venv/
tts/uv.lock

# ── Playwright 登录态（敏感，禁止备份外传）──────────────
data/browser_profile/

