{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.local/schemas/planner_result.schema.json",
  "title": "PlannerOutput",
  "description": "§04.1.2 Planner（方向分析）：5–8 个内容方向 + 四条规则的机器化校验依据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directions"
  ],
  "properties": {
    "directions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "rationale",
          "grounded_on",
          "priority",
          "risk_flags",
          "fit_score"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "grounded_on": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "persona",
                    "hot",
                    "feedback"
                  ]
                },
                "ref_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "quote": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "manual",
                    "auto",
                    null
                  ]
                }
              }
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fit_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    }
  }
}
