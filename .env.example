# ── 环境变量重定向契约（§README.6 · T1.1）────────────────────────────
# 用法：`ops\start_all.ps1` 或 `scripts\doctor.ps1` 会加载本文件同名的 .env；
#       CI / 手工调试可 `Copy-Item .env.example .env` 后修改。
# 硬约束：C 盘仅剩数 GB ⇒ 下列缓存与临时目录必须全部指向 D 盘。
# 门禁：free_C < 1 GB 或 free_D < 15 GB ⇒ doctor 报错并拒绝启动。

# ── 根路径 ──────────────────────────────────────────────
STUDIO_HOME=D:\Programming_Object\Fully_Automated_AI_Marketing_Account_Content_Production_Platform
STUDIO_DATA_DIR=D:\Programming_Object\Fully_Automated_AI_Marketing_Account_Content_Production_Platform\data

# ── 模型与缓存（全部落 D 盘，绝不落 C）──────────────────
HF_HOME=D:\ai_models\huggingface_cache
MODELSCOPE_CACHE=D:\ai_models\modelscope_cache
TORCH_HOME=D:\ai_models\torch
UV_CACHE_DIR=D:\ai_models\uv_cache
PIP_CACHE_DIR=D:\ai_models\pip_cache
PLAYWRIGHT_BROWSERS_PATH=D:\ai_models\playwright
NPM_CONFIG_CACHE=D:\ai_models\npm_cache

# ── 临时目录（FFmpeg 滤镜图 / 分块产物）─────────────────
TMP=D:\Programming_Object\Fully_Automated_AI_Marketing_Account_Content_Production_Platform\data\tmp
TEMP=D:\Programming_Object\Fully_Automated_AI_Marketing_Account_Content_Production_Platform\data\tmp

# ── 密钥（不入库、不入 git；此处仅占位）─────────────────
STUDIO_LLM_API_KEY=
STUDIO_LLM_BASE_URL=
STUDIO_WEBUI_PASSWORD=